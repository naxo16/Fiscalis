# =============================================================================
# CONFIGURACIÓN INSTITUCIONAL FISCALIS (SGF_CORE) - EJEMPLO DE ENTORNO
# =============================================================================

# Base de Datos (PostgreSQL con extensión PostGIS)
# Formato: postgresql+asyncpg://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgresql+asyncpg://fiscalis_admin:CambiarPorClaveSegura2026!@localhost:5432/fiscalis_core

# Clave Secreta JWT (Firma de tokens de sesión)
# Generar con: openssl rand -hex 32
SECRET_KEY=CambiarPorLlaveSecretaDeAlMenos32BytesHex2026!

# Algoritmo de firma
ALGORITHM=HS256

# Clave Fernet para encriptación de semillas TOTP y códigos de recuperación (Opcional, se deriva de SECRET_KEY si no se especifica)
MFA_ENCRYPTION_KEY=

# Modo Depuración (Siempre FALSE en producción institucional)
DEBUG=FALSE

# Metadatos del Sistema
PROJECT_NAME="Fiscalis - Sistema de Gestión Fiscalizadora"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Parámetros para Docker Compose
POSTGRES_DB=fiscalis_core
POSTGRES_USER=fiscalis_admin
POSTGRES_PASSWORD=CambiarPorClaveSegura2026!
